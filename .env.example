# ========================================================
# LOWKEY CAFE - ENVIRONMENT CONFIGURATION
# ========================================================

# Server Port
SERVER_PORT=8080

# Active Spring Profile: 'local' (Disk-persistent H2 MySQL-mode) or 'mysql' (External MySQL 8)
SPRING_PROFILES_ACTIVE=local

# MySQL 8 Database Configuration (Used when SPRING_PROFILES_ACTIVE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lowkeycafe
DB_USERNAME=root
DB_PASSWORD=root

# JWT Authentication Secret (256-bit Base64)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_LowkeyCafe2026
RAZORPAY_KEY_SECRET=dummy_razorpay_secret_key_lowkey

# Email Receipt SMTP Service (e.g. Gmail App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=lowkeycafe.receipts@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Frontend Base URL (Used for QR code target links)
APP_FRONTEND_BASE_URL=http://localhost:5173
